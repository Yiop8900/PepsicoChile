@model PepsicoChile.Models.Repuesto

@{
    ViewData["Title"] = "Detalle del Repuesto";
    var movimientos = ViewBag.Movimientos as List<PepsicoChile.Models.MovimientoRepuesto>;
    var stockBajo = Model.StockActual <= Model.StockMinimo;
    var stockCritico = Model.StockActual < (Model.StockMinimo * 0.5);
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2><i class="bi bi-box-seam"></i> Detalle del Repuesto</h2>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
            </div>
        </div>
    </div>

    <!-- Información Principal -->
    <div class="row mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Información General</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-5">Nombre:</dt>
                                <dd class="col-sm-7"><strong>@Model.Nombre</strong></dd>

                                <dt class="col-sm-5">Código:</dt>
                                <dd class="col-sm-7"><code class="fs-6">@Model.CodigoRepuesto</code></dd>

                                <dt class="col-sm-5">Categoría:</dt>
                                <dd class="col-sm-7">
                                    @if (!string.IsNullOrEmpty(Model.Categoria))
                                    {
                                        <span class="badge bg-info">@Model.Categoria</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No especificada</span>
                                    }
                                </dd>

                                <dt class="col-sm-5">Ubicación:</dt>
                                <dd class="col-sm-7">
                                    @if (!string.IsNullOrEmpty(Model.Ubicacion))
                                    {
                                        <i class="bi bi-geo-alt"></i> @Model.Ubicacion
                                    }
                                    else
                                    {
                                        <span class="text-muted">No especificada</span>
                                    }
                                </dd>
                            </dl>
                        </div>

                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-5">Precio Unit.:</dt>
                                <dd class="col-sm-7">
                                    @if (Model.PrecioUnitario.HasValue)
                                    {
                                        <strong>$@Model.PrecioUnitario.Value.ToString("N0")</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">No especificado</span>
                                    }
                                </dd>

                                <dt class="col-sm-5">Proveedor:</dt>
                                <dd class="col-sm-7">
                                    @if (!string.IsNullOrEmpty(Model.Proveedor))
                                    {
                                        <i class="bi bi-building"></i> @Model.Proveedor
                                    }
                                    else
                                    {
                                        <span class="text-muted">No especificado</span>
                                    }
                                </dd>

                                <dt class="col-sm-5">Fecha Creación:</dt>
                                <dd class="col-sm-7">
                                    <small>@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</small>
                                </dd>

                                <dt class="col-sm-5">Última Actualización:</dt>
                                <dd class="col-sm-7">
                                    <small>@Model.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</small>
                                </dd>
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Descripcion))
                    {
                        <hr />
                        <div>
                            <strong>Descripción:</strong>
                            <p class="mt-2 mb-0">@Model.Descripcion</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Panel de Stock -->
        <div class="col-lg-4">
            <div class="card shadow-sm mb-3 @(stockCritico ? "border-danger" : stockBajo ? "border-warning" : "border-success")">
                <div class="card-header @(stockCritico ? "bg-danger" : stockBajo ? "bg-warning" : "bg-success") text-white">
                    <h5 class="mb-0"><i class="bi bi-boxes"></i> Estado de Stock</h5>
                </div>
                <div class="card-body text-center">
                    <h1 class="display-4 @(stockCritico ? "text-danger" : stockBajo ? "text-warning" : "text-success")">
                        @Model.StockActual
                    </h1>
                    <p class="text-muted mb-1">Unidades disponibles</p>
                    <p class="mb-3">
                        <small>Stock Mínimo: @Model.StockMinimo unidades</small>
                    </p>

                    @if (stockCritico)
                    {
                        <div class="alert alert-danger mb-3">
                            <i class="bi bi-exclamation-triangle-fill"></i> 
                            <strong>¡Stock Crítico!</strong>
                        </div>
                    }
                    else if (stockBajo)
                    {
                        <div class="alert alert-warning mb-3">
                            <i class="bi bi-exclamation-circle-fill"></i> 
                            <strong>Stock Bajo</strong>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success mb-3">
                            <i class="bi bi-check-circle-fill"></i> 
                            <strong>Stock Normal</strong>
                        </div>
                    }

                    @if (Model.PrecioUnitario.HasValue)
                    {
                        <hr />
                        <p class="mb-1"><strong>Valor en Stock:</strong></p>
                        <h4 class="text-success">
                            $@((Model.StockActual * Model.PrecioUnitario.Value).ToString("N0"))
                        </h4>
                    }
                </div>
            </div>

            <!-- Acciones Rápidas -->
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0"><i class="bi bi-lightning"></i> Acciones Rápidas</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Entregar" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-box-arrow-right"></i> Entregar Repuesto
                        </a>
                        <a asp-action="RecibirStock" asp-route-id="@Model.Id" class="btn btn-success">
                            <i class="bi bi-box-arrow-in-down"></i> Recibir Stock
                        </a>
                        <a asp-action="Historial" asp-route-repuestoId="@Model.Id" class="btn btn-info">
                            <i class="bi bi-clock-history"></i> Ver Historial
                        </a>
                        <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Últimos Movimientos -->
    @if (movimientos != null && movimientos.Any())
    {
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="bi bi-clock-history"></i> Últimos Movimientos</h5>
                            <a asp-action="Historial" asp-route-repuestoId="@Model.Id" class="btn btn-sm btn-outline-primary">
                                Ver Todo el Historial
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Tipo</th>
                                        <th class="text-center">Cantidad</th>
                                        <th class="text-center">Stock</th>
                                        <th>Motivo</th>
                                        <th>Vehículo</th>
                                        <th>Mecánico</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mov in movimientos)
                                    {
                                        var esEntrada = mov.TipoMovimiento == "Entrada";
                                        
                                        <tr>
                                            <td>
                                                <small>
                                                    @mov.FechaMovimiento.ToString("dd/MM/yyyy")<br/>
                                                    @mov.FechaMovimiento.ToString("HH:mm")
                                                </small>
                                            </td>
                                            <td>
                                                @if (esEntrada)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-arrow-down"></i> Entrada
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        <i class="bi bi-arrow-up"></i> Salida
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <strong>@(esEntrada ? "+" : "-")@mov.Cantidad</strong>
                                            </td>
                                            <td class="text-center">
                                                <small class="text-muted">@mov.StockAnterior ?</small>
                                                <strong>@mov.StockNuevo</strong>
                                            </td>
                                            <td>
                                                <small>@(mov.Motivo ?? "-")</small>
                                            </td>
                                            <td>
                                                @if (mov.Vehiculo != null)
                                                {
                                                    <span class="badge bg-secondary">@mov.Vehiculo.Patente</span>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">-</small>
                                                }
                                            </td>
                                            <td>
                                                @if (mov.Mecanico != null)
                                                {
                                                    <small>@mov.Mecanico.Nombre</small>
                                                }
                                                else
                                                {
                                                    <small class="text-muted">-</small>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .card {
        border-radius: 10px;
    }
    
    dl dt {
        font-weight: 600;
        color: #6c757d;
    }
    
    .table small {
        display: block;
        line-height: 1.3;
    }
</style>
