@model List<Vehiculo>
@{
    ViewData["Title"] = "Vehículos de la Flota";
}

<div class="row mb-4">
    <div class="col-12">
  <h1><i class="bi bi-truck-front"></i> Vehículos de la Flota</h1>
        <p class="lead">Gestión y consulta de todos los vehículos</p>
    </div>
</div>

<!-- Resumen por Estado -->
<div class="row mb-4">
 <div class="col-md-4">
        <div class="card text-white bg-success">
    <div class="card-body text-center">
    <h5 class="card-title">Disponibles</h5>
    <p class="display-4">@Model.Count(v => v.Estado == "Disponible")</p>
   </div>
 </div>
    </div>
    <div class="col-md-4">
   <div class="card text-white bg-warning">
 <div class="card-body text-center">
       <h5 class="card-title">En Taller</h5>
      <p class="display-4">@Model.Count(v => v.Estado == "En Taller")</p>
 </div>
 </div>
    </div>
 <div class="col-md-4">
    <div class="card text-white bg-info">
       <div class="card-body text-center">
        <h5 class="card-title">En Ruta</h5>
     <p class="display-4">@Model.Count(v => v.Estado == "En Ruta")</p>
        </div>
  </div>
 </div>
</div>

<!-- Filtros -->
<div class="row mb-3">
 <div class="col-md-12">
   <div class="card">
 <div class="card-body">
      <div class="row">
  <div class="col-md-3">
     <label class="form-label">Buscar por Patente</label>
    <input type="text" class="form-control" placeholder="Ej: ABCD-12" />
   </div>
       <div class="col-md-3">
     <label class="form-label">Filtrar por Estado</label>
  <select class="form-select">
      <option value="">Todos</option>
   <option value="Disponible">Disponible</option>
      <option value="En Taller">En Taller</option>
 <option value="En Ruta">En Ruta</option>
      </select>
 </div>
   <div class="col-md-3">
<label class="form-label">Filtrar por Tipo</label>
       <select class="form-select">
       <option value="">Todos</option>
    <option value="Camión">Camión</option>
    <option value="Camioneta">Camioneta</option>
   </select>
 </div>
  <div class="col-md-3 d-flex align-items-end">
  <button class="btn btn-primary w-100">
  <i class="bi bi-search"></i> Buscar
 </button>
   </div>
  </div>
   </div>
        </div>
    </div>
</div>

<!-- Listado de Vehículos -->
<div class="row">
    @foreach (var vehiculo in Model)
    {
        <div class="col-md-6 col-lg-4 mb-3">
   <div class="card h-100">
    <div class="card-header @(vehiculo.Estado == "Disponible" ? "bg-success text-white" : vehiculo.Estado == "En Taller" ? "bg-warning" : "bg-info text-white")">
  <h5 class="mb-0">
       <i class="bi bi-truck"></i> @vehiculo.Patente
    </h5>
   </div>
  <div class="card-body">
     <h6 class="card-subtitle mb-2 text-muted">@vehiculo.TipoVehiculo</h6>
        <p class="card-text">
    <strong>Marca:</strong> @vehiculo.Marca<br />
       <strong>Modelo:</strong> @vehiculo.Modelo<br />
  <strong>Año:</strong> @vehiculo.Año<br />
        <strong>Kilometraje:</strong> @vehiculo.KilometrajeActual?.ToString("N0") km<br />
<strong>Estado:</strong> 
    @switch (vehiculo.Estado)
      {
    case "Disponible":
        <span class="badge bg-success">@vehiculo.Estado</span>
 break;
   case "En Taller":
 <span class="badge bg-warning">@vehiculo.Estado</span>
       break;
        case "En Ruta":
   <span class="badge bg-info">@vehiculo.Estado</span>
   break;
      default:
    <span class="badge bg-secondary">@vehiculo.Estado</span>
      break;
    }
   </p>
      </div>
     <div class="card-footer">
       <div class="btn-group w-100" role="group">
       <a asp-action="Detalle" asp-route-id="@vehiculo.Id" class="btn btn-sm btn-primary">
   <i class="bi bi-info-circle"></i> Detalle
     </a>
      <a asp-action="Historial" asp-route-id="@vehiculo.Id" class="btn btn-sm btn-info">
       <i class="bi bi-clock-history"></i> Historial
   </a>
 <a asp-action="DocumentosVehiculo" asp-route-id="@vehiculo.Id" class="btn btn-sm btn-secondary">
    <i class="bi bi-file-earmark"></i> Docs
    </a>
  </div>
   </div>
   </div>
        </div>
    }
</div>
