@model List<Vehiculo>
@{
    ViewData["Title"] = "Gestión de Vehículos";
    var usuarioRol = Context.Session.GetString("UsuarioRol");
    var puedeAsignar = usuarioRol == "Administrador" || usuarioRol == "JefeTaller" ||
                       usuarioRol == "Supervisor" || usuarioRol == "CoordinadorZona" || usuarioRol == "Recepcionista";
}

<div class="row mb-4">
    <div class="col-md-6">
        <h2><i class="bi bi-truck-front-fill"></i> Gestión de Vehículos</h2>
    </div>
    <div class="col-md-6 text-end">
        @if (puedeAsignar)
        {
            <a asp-action="VehiculosPorChofer" class="btn btn-info btn-lg me-2">
                <i class="bi bi-person-badge"></i> Vehículos por Chofer
            </a>
            <a asp-action="Agregar" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> Agregar Vehículo
            </a>
        }

    </div>
</div>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <input type="text" id="filtroPatente" class="form-control" placeholder="Buscar por patente..." />
            </div>
            <div class="col-md-3">
                <select id="filtroTipo" class="form-select">
                    <option value="">Todos los tipos</option>
                    <option>Camión</option>
                    <option>Camioneta</option>
                    <option>Furgón</option>
                </select>
            </div>
            <div class="col-md-3">
                <select id="filtroEstado" class="form-select">
                    <option value="">Todos los estados</option>
                    <option>Disponible</option>
                    <option>En Taller</option>
                    <option>En Ruta</option>
                    <option>Inactivo</option>
                </select>
            </div>
            <div class="col-md-3">
                <button class="btn btn-secondary w-100" onclick="limpiarFiltros()">
                    <i class="bi bi-x-circle"></i> Limpiar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Token antifalsificación para formularios AJAX -->
@Html.AntiForgeryToken()

<!-- Lista de vehículos -->
<div class="row" id="vehiculosContainer">
    @foreach (var vehiculo in Model)
    {
        var colorEstado = vehiculo.Estado switch
        {
            "Disponible" => "success",
            "En Taller" => "warning",
            "En Ruta" => "info",
            "Inactivo" => "danger",
            _ => "secondary"
        };

        <div class="col-md-6 col-lg-4 mb-4 vehiculo-card"
             data-patente="@vehiculo.Patente"
             data-tipo="@vehiculo.TipoVehiculo"
             data-estado="@vehiculo.Estado">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-@colorEstado text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-truck"></i> @vehiculo.Patente
                        </h5>
                        <span class="badge bg-light text-dark">@vehiculo.TipoVehiculo</span>
                    </div>
                </div>
                <div class="card-body">
                    <h6 class="card-title">@vehiculo.Marca @vehiculo.Modelo</h6>
                    <div class="row g-2 small">
                        <div class="col-6">
                            <strong>Año:</strong> @vehiculo.Año
                        </div>
                        <div class="col-6">
                            <strong>Flota:</strong> @(vehiculo.NumeroFlota ?? "N/A")
                        </div>
                        <div class="col-6">
                            <strong>Combustible:</strong> @(vehiculo.Combustible ?? "N/A")
                        </div>
                        <div class="col-6">
                            <strong>Km:</strong> @(vehiculo.KilometrajeActual?.ToString("N0") ?? "N/A")
                        </div>
                        <div class="col-12 mt-2">
                            <span class="badge bg-@colorEstado">
                                <i class="bi bi-@(vehiculo.Estado == "Disponible" ? "check-circle" :
                                                                                                                                                  vehiculo.Estado == "En Taller" ? "tools" :
                                                                                                                                                    vehiculo.Estado == "En Ruta" ? "geo-alt" : "x-circle")"></i>
                                @vehiculo.Estado
                            </span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(vehiculo.Observaciones))
                    {
                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="bi bi-info-circle"></i> @vehiculo.Observaciones
                            </small>
                        </div>
                    }

                    <div class="mt-3">
                        <div class="btn-group w-100" role="group">
                            <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots"></i> Acciones
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-action="Detalle" asp-route-id="@vehiculo.Id">
                                        <i class="bi bi-eye"></i> Ver Detalle
                                    </a>
                                </li>

                                @if (puedeAsignar)
                                {
                                    <li>
                                        <a class="dropdown-item" asp-action="AsignarChofer" asp-route-id="@vehiculo.Id">
                                            <i class="bi bi-person-plus"></i> Asignar Chofer
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-action="Editar" asp-route-id="@vehiculo.Id">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">Cambiar Estado</h6></li>
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="cambiarEstado(@vehiculo.Id, 'Disponible'); return false;">
                                            <i class="bi bi-check-circle text-success"></i> Disponible
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="cambiarEstado(@vehiculo.Id, 'En Taller'); return false;">
                                            <i class="bi bi-tools text-warning"></i> En Taller
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="cambiarEstado(@vehiculo.Id, 'En Ruta'); return false;">
                                            <i class="bi bi-geo-alt text-info"></i> En Ruta
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="cambiarEstado(@vehiculo.Id, 'Inactivo'); return false;">
                                            <i class="bi bi-x-circle text-danger"></i> Inactivo
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item" asp-action="VerDocumentos" asp-route-id="@vehiculo.Id">
                                        <i class="bi bi-file-earmark-text"></i> Documentos
                                    </a>
                                </li>

                            </ul>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-muted small">
                    <i class="bi bi-clock"></i> Actualizado: @vehiculo.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle"></i> No hay vehículos registrados.
        <a asp-action="Agregar" class="alert-link">Agregar el primero</a>
    </div>
}

@section Scripts {
    <script>
             function cambiarEstado(id, estado) {
          if (confirm(`¿Cambiar estado del vehículo a "${estado}"?`)) {
                var form = document.createElement('form');
          form.method = 'POST';
             form.action = '@Url.Action("CambiarEstado")';

            var inputId = document.createElement('input');
        inputId.type = 'hidden';
         inputId.name = 'id';
              inputId.value = id;
             form.appendChild(inputId);

           var inputEstado = document.createElement('input');
                 inputEstado.type = 'hidden';
             inputEstado.name = 'estado';
           inputEstado.value = estado;
             form.appendChild(inputEstado);

            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
               var inputToken = document.createElement('input');
             inputToken.type = 'hidden';
            inputToken.name = '__RequestVerificationToken';
             inputToken.value = token.value;
                form.appendChild(inputToken);
              }

          document.body.appendChild(form);
            form.submit();
           }
            return false;
             }

                // Filtros
           document.getElementById('filtroPatente').addEventListener('input', filtrar);
         document.getElementById('filtroTipo').addEventListener('change', filtrar);
         document.getElementById('filtroEstado').addEventListener('change', filtrar);

           function filtrar() {
          var patente = document.getElementById('filtroPatente').value.toUpperCase();
              var tipo = document.getElementById('filtroTipo').value;
            var estado = document.getElementById('filtroEstado').value;

             document.querySelectorAll('.vehiculo-card').forEach(card => {
           var cardPatente = card.dataset.patente;
            var cardTipo = card.dataset.tipo;
          var cardEstado = card.dataset.estado;

            var mostrar = true;
         if (patente && !cardPatente.includes(patente)) mostrar = false;
             if (tipo && cardTipo !== tipo) mostrar = false;
              if (estado && cardEstado !== estado) mostrar = false;

             card.style.display = mostrar ? '' : 'none';
             });
          }

         function limpiarFiltros() {
          document.getElementById('filtroPatente').value = '';
         document.getElementById('filtroTipo').value = '';
         document.getElementById('filtroEstado').value = '';
           filtrar();
                }
    </script>
}
