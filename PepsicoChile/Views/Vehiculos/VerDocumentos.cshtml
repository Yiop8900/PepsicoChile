@model List<DocumentoVehiculo>
@{
    ViewData["Title"] = "Documentos del Vehículo";
    var vehiculo = ViewBag.Vehiculo as Vehiculo;
}

<div class="row mb-4">
    <div class="col-md-8">
     <h2>
      <i class="bi bi-file-earmark-text"></i> Documentos del Vehículo
        </h2>
     <h4 class="text-muted">
      <i class="bi bi-truck"></i> @vehiculo?.Patente - @vehiculo?.Marca @vehiculo?.Modelo
        </h4>
    </div>
    <div class="col-md-4 text-end">
     <a asp-action="Index" class="btn btn-secondary">
          <i class="bi bi-arrow-left"></i> Volver
</a>
    </div>
</div>

<div class="row">
    @foreach (var doc in Model)
{
        var esVencido = doc.FechaVencimiento.HasValue && doc.FechaVencimiento.Value < DateTime.Now;
   var porVencer = doc.FechaVencimiento.HasValue && 
    doc.FechaVencimiento.Value >= DateTime.Now && 
     doc.FechaVencimiento.Value <= DateTime.Now.AddDays(30);
        
 <div class="col-md-6 col-lg-4 mb-4">
 <div class="card h-100 @(esVencido ? "border-danger" : porVencer ? "border-warning" : "")">
     <div class="card-header bg-@(esVencido ? "danger" : porVencer ? "warning" : "primary") text-white">
       <h6 class="mb-0">
       <i class="bi bi-@(doc.TipoDocumento == "RevisionTecnica" ? "file-check" :
         doc.TipoDocumento == "SeguroObligatorio" ? "shield-check" :
      doc.TipoDocumento == "PermisoCirculacion" ? "card-checklist" :
   doc.TipoDocumento == "Contrato" ? "file-text" :
      doc.TipoDocumento == "Manual" ? "book" : "file-earmark")"></i>
       @doc.TipoDocumento
   </h6>
     </div>
 <div class="card-body">
   <p class="mb-2"><strong>Archivo:</strong> @doc.NombreArchivo</p>
       <p class="mb-2"><strong>Subido:</strong> @doc.FechaSubida.ToString("dd/MM/yyyy HH:mm")</p>
   <p class="mb-2"><strong>Tamaño:</strong> @((doc.TamañoBytes / 1024.0).ToString("N2")) KB</p>
    
 @if (doc.FechaVencimiento.HasValue)
   {
      <p class="mb-2">
 <strong>Vencimiento:</strong>
   <span class="badge bg-@(esVencido ? "danger" : porVencer ? "warning" : "success")">
      @doc.FechaVencimiento.Value.ToString("dd/MM/yyyy")
 @if (esVencido)
      {
        <text>(VENCIDO)</text>
        }
     else if (porVencer)
 {
        <text>(Por vencer)</text>
     }
  </span>
       </p>
     }
 
  @if (!string.IsNullOrEmpty(doc.Descripcion))
{
   <p class="small text-muted">@doc.Descripcion</p>
    }

        <div class="d-grid gap-2 mt-3">
      <a href="@doc.RutaArchivo" target="_blank" class="btn btn-sm btn-primary">
     <i class="bi bi-download"></i> Descargar
    </a>
     </div>
  </div>
   </div>
  </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
     <i class="bi bi-info-circle"></i> No hay documentos registrados para este vehículo.
    </div>
}
