@model List<IngresoTaller>
@{
    ViewData["Title"] = "Mis Ingresos";
}

<div class="row mb-4">
    <div class="col-12">
<h1><i class="bi bi-list-check"></i> Mis Ingresos al Taller</h1>
        <p class="lead">Historial de ingresos de vehículos registrados</p>
    </div>
</div>

<div class="row mb-3">
    <div class="col-12">
        <a asp-action="RegistrarLlegada" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Registrar Nueva Llegada
</a>
    </div>
</div>

<div class="row">
  <div class="col-12">
        @if (Model.Any())
        {
<div class="table-responsive">
    <table class="table table-striped table-hover">
<thead class="table-dark">
     <tr>
       <th>Patente</th>
    <th>Vehículo</th>
           <th>Fecha Programada</th>
   <th>Fecha Ingreso</th>
          <th>Motivo</th>
           <th>Estado</th>
         <th>Acciones</th>
         </tr>
     </thead>
   <tbody>
    @foreach (var ingreso in Model)
        {
     <tr>
 <td><strong>@ingreso.Vehiculo?.Patente</strong></td>
           <td>@ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo</td>
            <td>@ingreso.FechaProgramada.ToString("dd/MM/yyyy HH:mm")</td>
         <td>
    @if (ingreso.FechaIngresoReal.HasValue)
     {
   @ingreso.FechaIngresoReal.Value.ToString("dd/MM/yyyy HH:mm")
 }
       else
           {
      <span class="text-muted">Pendiente</span>
      }
               </td>
         <td>@ingreso.MotivoIngreso</td>
 <td>
            @switch (ingreso.Estado)
       {
     case "En Proceso":
     <span class="badge bg-warning">@ingreso.Estado</span>
   break;
         case "Programado":
            <span class="badge bg-info">@ingreso.Estado</span>
        break;
      case "Completado":
    <span class="badge bg-success">@ingreso.Estado</span>
     break;
  case "Pausado":
                <span class="badge bg-danger">@ingreso.Estado</span>
        break;
        default:
      <span class="badge bg-secondary">@ingreso.Estado</span>
            break;
         }
       </td>
  <td>
        <a asp-action="DetalleIngreso" asp-route-id="@ingreso.Id" class="btn btn-sm btn-info">
              <i class="bi bi-eye"></i> Ver
            </a>
    </td>
       </tr>
  }
      </tbody>
      </table>
     </div>
        }
 else
   {
            <div class="alert alert-info">
      <i class="bi bi-info-circle"></i> No hay ingresos registrados aún.
       </div>
    }
    </div>
</div>
