@{
    ViewData["Title"] = "Configuración Inicial";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
         min-height: 100vh;
    padding: 2rem;
        }
        .setup-container {
     background: white;
       border-radius: 15px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.2);
      padding: 2rem;
    max-width: 900px;
          margin: 0 auto;
        }
        pre {
    background: #f8f9fa;
   padding: 1.5rem;
 border-radius: 8px;
            border-left: 4px solid #004B8D;
            font-family: 'Courier New', monospace;
       font-size: 0.9rem;
  line-height: 1.6;
    overflow-x: auto;
        }
        .btn-action {
        margin: 0.5rem;
  }
    </style>
</head>
<body>
    <div class="setup-container">
        <div class="text-center mb-4">
<i class="bi bi-gear-fill text-primary" style="font-size: 4rem;"></i>
 <h1 class="mt-3">Configuración Inicial</h1>
      <p class="text-muted">Sistema de Gestión de Taller - PepsiCo Chile</p>
     </div>

        @if (TempData["Mensaje"] != null)
 {
            <div class="alert alert-success alert-dismissible fade show">
 @TempData["Mensaje"]
     <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
      @TempData["Error"]
       <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
        }

        <div class="card mb-4">
       <div class="card-header bg-primary text-white">
     <h5 class="mb-0"><i class="bi bi-clipboard-data"></i> Diagnóstico del Sistema</h5>
     </div>
<div class="card-body">
         <pre>@ViewBag.DiagnosticoTexto</pre>
  </div>
        </div>

 <div class="card mb-4">
  <div class="card-header bg-success text-white">
   <h5 class="mb-0"><i class="bi bi-tools"></i> Acciones de Configuración</h5>
     </div>
            <div class="card-body">
                <div class="row">
 <div class="col-md-6">
              <form asp-action="AplicarMigraciones" method="post">
  <button type="submit" class="btn btn-primary btn-lg w-100 btn-action">
       <i class="bi bi-database-fill-gear"></i><br>
     Aplicar Migraciones
          </button>
   <small class="text-muted d-block mt-2">Crea o actualiza las tablas de la base de datos</small>
                </form>
        </div>
     <div class="col-md-6">
   <form asp-action="CrearUsuarioDemo" method="post">
     <button type="submit" class="btn btn-success btn-lg w-100 btn-action">
<i class="bi bi-person-plus-fill"></i><br>
   Crear Usuario Admin
    </button>
     <small class="text-muted d-block mt-2">Email: admin@pepsico.cl / Pass: 123456</small>
            </form>
         </div>
     </div>
   </div>
        </div>

        <div class="card">
            <div class="card-header bg-info text-white">
      <h5 class="mb-0"><i class="bi bi-info-circle"></i> Instrucciones</h5>
            </div>
      <div class="card-body">
    <h6>Si el diagnóstico muestra errores:</h6>
   <ol>
         <li>Click en "Aplicar Migraciones" para crear/actualizar la base de datos</li>
         <li>Click en "Crear Usuario Admin" para crear el primer usuario</li>
            <li>Ve a <a href="/Account/Login">/Account/Login</a> e inicia sesión</li>
        </ol>

   <hr>

     <h6>Si necesitas reiniciar completamente:</h6>
 <p>Abre <strong>Package Manager Console</strong> en Visual Studio y ejecuta:</p>
 <pre style="background: #2d2d2d; color: #f8f8f8;">PM> Drop-Database
PM> Add-Migration InitialCreate
PM> Update-Database</pre>

    <hr>

                <div class="alert alert-warning">
     <strong><i class="bi bi-exclamation-triangle"></i> Nota:</strong>
  Si SQL Server LocalDB no está corriendo, ábrelo desde:
                <code>Services ? SQL Server (MSSQLLOCALDB) ? Start</code>
   </div>
            </div>
 </div>

        <div class="text-center mt-4">
         <a href="/Account/Login" class="btn btn-outline-primary">
           <i class="bi bi-box-arrow-in-right"></i> Ir al Login
    </a>
     <a href="/" class="btn btn-outline-secondary">
                <i class="bi bi-house"></i> Ir al Inicio
     </a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
