@model MonitoreoGeneralViewModel
@{
    ViewData["Title"] = "Monitoreo General";
    var programados = Model.IngresosActivos.Where(i => i.Estado == "Programado").ToList();
    var enProceso = Model.IngresosActivos.Where(i => i.Estado == "En Proceso").ToList();
    var pausados = Model.IngresosActivos.Where(i => i.Estado == "Pausado").ToList();
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2><i class="bi bi-display"></i> Monitoreo General del Taller</h2>
      <p class="text-muted">Vista en tiempo real de todos los ingresos activos</p>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="Agenda" class="btn btn-outline-primary me-2">
     <i class="bi bi-calendar3"></i> Ver Agenda
        </a>
        <a asp-action="ProgramarIngreso" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Programar Ingreso
        </a>
    </div>
</div>

<!-- Resumen de Estados -->
<div class="row mb-4">
    <div class="col-md-3">
   <div class="card bg-info text-white h-100">
            <div class="card-body text-center">
     <i class="bi bi-calendar-check fs-1 mb-2"></i>
          <h2 class="mb-0">@programados.Count</h2>
   <p class="mb-0">Programados</p>
         @if (programados.Any())
    {
         <small class="d-block mt-2">
    Próximo: @programados.OrderBy(i => i.FechaProgramada).First().FechaProgramada.ToString("dd/MM HH:mm")
       </small>
   }
      </div>
    </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white h-100">
            <div class="card-body text-center">
      <i class="bi bi-gear-fill fs-1 mb-2"></i>
          <h2 class="mb-0">@enProceso.Count</h2>
           <p class="mb-0">En Proceso</p>
              @if (enProceso.Any())
    {
     <small class="d-block mt-2">
     @enProceso.Count vehículo@(enProceso.Count != 1 ? "s" : "") en taller
       </small>
       }
   </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-danger text-white h-100">
            <div class="card-body text-center">
       <i class="bi bi-pause-circle-fill fs-1 mb-2"></i>
     <h2 class="mb-0">@pausados.Count</h2>
           <p class="mb-0">Pausados</p>
                @if (pausados.Any())
            {
             <small class="d-block mt-2">
         Requieren atención
       </small>
   }
            </div>
        </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-dark text-white h-100">
  <div class="card-body text-center">
             <i class="bi bi-list-check fs-1 mb-2"></i>
        <h2 class="mb-0">@Model.IngresosActivos.Count</h2>
     <p class="mb-0">Total Activos</p>
         <small class="d-block mt-2">
         Capacidad del taller
    </small>
         </div>
 </div>
    </div>
</div>

@if (!Model.IngresosActivos.Any())
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle fs-1 d-block mb-3"></i>
  <h4>No hay ingresos activos en este momento</h4>
        <p>El taller está disponible para nuevos ingresos.</p>
 <a asp-action="ProgramarIngreso" class="btn btn-primary">
   <i class="bi bi-plus-circle"></i> Programar Primer Ingreso
   </a>
    </div>
}
else
{
    <!-- Ingresos Pausados (Prioridad) -->
    @if (pausados.Any())
    {
  <div class="card mb-4 border-danger">
            <div class="card-header bg-danger text-white">
              <h5 class="mb-0">
  <i class="bi bi-exclamation-triangle-fill"></i> 
        Ingresos Pausados - Requieren Atención (@pausados.Count)
      </h5>
</div>
            <div class="card-body">
       <div class="row">
          @foreach (var ingreso in pausados)
       {
             <div class="col-md-6 mb-3">
      <div class="card border-danger">
      <div class="card-body">
  <div class="d-flex justify-content-between align-items-start mb-2">
             <div>
           <h5 class="mb-1">
                     <i class="bi bi-truck text-danger"></i> 
             @ingreso.Vehiculo?.Patente
       </h5>
         <small class="text-muted">
            @ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo
            </small>
              </div>
     <span class="badge bg-danger">PAUSADO</span>
    </div>
        <p class="mb-2">
  <strong>Motivo:</strong> @ingreso.MotivoIngreso
            </p>
      <p class="mb-2 small">
             <i class="bi bi-person"></i> <strong>Chofer:</strong> @ingreso.Chofer?.Nombre @ingreso.Chofer?.Apellido
   </p>
    @if (ingreso.MecanicoAsignado != null)
              {
  <p class="mb-2 small">
 <i class="bi bi-person-gear"></i> <strong>Mecánico:</strong> @ingreso.MecanicoAsignado.Nombre
     </p>
             }
    <hr />
   <div class="d-flex justify-content-between align-items-center">
         <small class="text-muted">
        <i class="bi bi-calendar"></i> 
               @ingreso.FechaProgramada.ToString("dd/MM/yyyy HH:mm")
     </small>
   <a asp-action="GestionarIngreso" asp-route-id="@ingreso.Id" 
   class="btn btn-sm btn-danger">
       <i class="bi bi-play-circle"></i> Reanudar
            </a>
      </div>
          </div>
   </div>
                   </div>
          }
       </div>
            </div>
        </div>
  }

    <!-- Ingresos En Proceso -->
    @if (enProceso.Any())
  {
   <div class="card mb-4 border-warning">
            <div class="card-header bg-warning text-dark">
    <h5 class="mb-0">
         <i class="bi bi-gear-fill"></i> 
            Ingresos En Proceso (@enProceso.Count)
      </h5>
    </div>
            <div class="card-body">
   <div class="row">
  @foreach (var ingreso in enProceso.OrderBy(i => i.FechaIngresoReal))
          {
       <div class="col-md-6 mb-3">
             <div class="card border-warning">
             <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-2">
    <div>
<h5 class="mb-1">
        <i class="bi bi-truck text-warning"></i> 
         @ingreso.Vehiculo?.Patente
        </h5>
           <small class="text-muted">
        @ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo
       </small>
            </div>
              <span class="badge bg-warning text-dark">EN PROCESO</span>
   </div>
     <p class="mb-2">
   <strong>Motivo:</strong> @ingreso.MotivoIngreso
    </p>
       <p class="mb-2 small">
            <i class="bi bi-person"></i> <strong>Chofer:</strong> @ingreso.Chofer?.Nombre
      </p>
         @if (ingreso.MecanicoAsignado != null)
              {
   <p class="mb-2 small">
     <i class="bi bi-person-check text-success"></i> 
      <strong>Mecánico:</strong> @ingreso.MecanicoAsignado.Nombre @ingreso.MecanicoAsignado.Apellido
 </p>
     }
 else
             {
        <p class="mb-2 small text-warning">
        <i class="bi bi-person-x"></i> Sin mecánico asignado
     </p>
      }
      @if (ingreso.RequiereRepuestos)
                {
        <span class="badge bg-warning text-dark mb-2">
              <i class="bi bi-tools"></i> Requiere Repuestos
    </span>
                   }
         <hr />
        <div class="d-flex justify-content-between align-items-center">
      <div>
        <small class="text-muted d-block">
 <i class="bi bi-clock"></i> Ingresó: 
    @(ingreso.FechaIngresoReal.HasValue ? 
           ingreso.FechaIngresoReal.Value.ToString("dd/MM HH:mm") : "N/A")
        </small>
     @if (ingreso.FechaIngresoReal.HasValue)
    {
         var horasEnTaller = (DateTime.Now - ingreso.FechaIngresoReal.Value).TotalHours;
          <small class="text-muted">
    Tiempo: @horasEnTaller.ToString("N1") hrs
          </small>
          }
          </div>
              <a asp-action="GestionarIngreso" asp-route-id="@ingreso.Id" 
 class="btn btn-sm btn-warning">
  <i class="bi bi-gear"></i> Gestionar
              </a>
         </div>
           </div>
            </div>
       </div>
  }
    </div>
            </div>
        </div>
    }

    <!-- Ingresos Programados -->
    @if (programados.Any())
    {
    <div class="card mb-4">
  <div class="card-header bg-info text-white">
         <h5 class="mb-0">
       <i class="bi bi-calendar-check"></i> 
Próximos Ingresos Programados (@programados.Count)
         </h5>
         </div>
            <div class="card-body">
            <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
   <thead>
           <tr>
          <th>Vehículo</th>
         <th>Chofer</th>
 <th>Mecánico</th>
   <th>Motivo</th>
   <th>Fecha Programada</th>
             <th>Repuestos</th>
          <th>Acciones</th>
 </tr>
  </thead>
     <tbody>
@foreach (var ingreso in programados.OrderBy(i => i.FechaProgramada))
             {
  var esHoy = ingreso.FechaProgramada.Date == DateTime.Today;
    var esAtrasado = ingreso.FechaProgramada < DateTime.Now;
      
          <tr class="@(esAtrasado ? "table-danger" : esHoy ? "table-info" : "")">
      <td>
            <strong>@ingreso.Vehiculo?.Patente</strong><br />
           <small class="text-muted">
  @ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo
           </small>
           </td>
          <td>@ingreso.Chofer?.Nombre @ingreso.Chofer?.Apellido</td>
     <td>
         @if (ingreso.MecanicoAsignado != null)
      {
    <span class="badge bg-success">
        <i class="bi bi-person-check"></i> @ingreso.MecanicoAsignado.Nombre
               </span>
          }
            else
 {
          <span class="text-muted small">
               <i class="bi bi-person-x"></i> Sin asignar
             </span>
   }
  </td>
        <td>
       <span class="badge bg-secondary">@ingreso.MotivoIngreso</span>
          </td>
      <td>
       @if (esAtrasado)
            {
   <i class="bi bi-exclamation-circle text-danger"></i>
           }
        else if (esHoy)
      {
          <i class="bi bi-calendar-check text-info"></i>
   }
           @ingreso.FechaProgramada.ToString("dd/MM/yyyy HH:mm")
       @if (esHoy)
{
        <br /><small class="badge bg-info">HOY</small>
      }
      @if (esAtrasado)
        {
                 <br /><small class="badge bg-danger">ATRASADO</small>
        }
          </td>
        <td class="text-center">
    @if (ingreso.RequiereRepuestos)
                 {
       <i class="bi bi-tools text-warning fs-5"></i>
     }
    else
  {
           <span class="text-muted">-</span>
      }
            </td>
   <td>
            <div class="btn-group">
          <a asp-action="GestionarIngreso" asp-route-id="@ingreso.Id" 
      class="btn btn-sm btn-primary">
   <i class="bi bi-gear"></i>
       </a>
          @if (esHoy || esAtrasado)
        {
     <form asp-action="IniciarIngreso" method="post" class="d-inline">
     <input type="hidden" name="id" value="@ingreso.Id" />
     <button type="submit" class="btn btn-sm btn-success" 
              title="Iniciar ingreso">
        <i class="bi bi-play-fill"></i>
               </button>
 </form>
         }
            </div>
          </td>
    </tr>
         }
              </tbody>
  </table>
           </div>
      </div>
        </div>
    }
}

<!-- Trabajos Completados Recientemente -->
@if (Model.IngresosCompletados.Any())
{
    <div class="card border-success mb-4">
 <div class="card-header bg-success text-white">
       <h5 class="mb-0">
      <i class="bi bi-check-circle-fill"></i> 
   Trabajos Completados Recientemente (@Model.IngresosCompletados.Count)
     <small class="ms-2">(Últimos 15 días)</small>
      </h5>
        </div>
        <div class="card-body">
   <div class="table-responsive">
     <table class="table table-sm table-hover align-middle mb-0">
      <thead>
   <tr>
  <th>Patente</th>
    <th>Vehículo</th>
        <th>Chofer</th>
  <th>Mecánico</th>
     <th>Motivo</th>
           <th>Ingreso</th>
      <th>Salida</th>
  <th>Tiempo</th>
       <th>Estado</th>
  <th>Ver</th>
     </tr>
  </thead>
    <tbody>
   @foreach (var ingreso in Model.IngresosCompletados)
 {
   var tiempoTotal = ingreso.FechaIngresoReal.HasValue && ingreso.FechaSalidaReal.HasValue
    ? (ingreso.FechaSalidaReal.Value - ingreso.FechaIngresoReal.Value).TotalHours
           : 0;

    <tr class="@(ingreso.Estado == "Completado" ? "table-success" : "")">
  <td><strong>@ingreso.Vehiculo?.Patente</strong></td>
  <td><small>@ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo</small></td>
  <td><small>@ingreso.Chofer?.Nombre</small></td>
   <td>
  @if (ingreso.MecanicoAsignado != null)
        {
           <span class="badge bg-success">
        @ingreso.MecanicoAsignado.Nombre
     </span>
   }
  else
      {
             <span class="text-muted">-</span>
 }
</td>
           <td><small>@ingreso.MotivoIngreso</small></td>
       <td>
   <small>
       @if (ingreso.FechaIngresoReal.HasValue)
        {
   @ingreso.FechaIngresoReal.Value.ToString("dd/MM HH:mm")
    }
        </small>
       </td>
  <td>
    <small>
   @if (ingreso.FechaSalidaReal.HasValue)
   {
    @ingreso.FechaSalidaReal.Value.ToString("dd/MM HH:mm")
       }
      </small>
    </td>
   <td>
      @if (tiempoTotal > 0)
     {
    <span class="badge bg-info">
  @tiempoTotal.ToString("N1") h
       </span>
    }
       else
      {
  <span class="text-muted">-</span>
      }
       </td>
  <td>
   @if (ingreso.Estado == "Completado")
    {
       <span class="badge bg-success">
        <i class="bi bi-check-circle"></i> OK
        </span>
       }
    else
        {
   <span class="badge bg-secondary">
   @ingreso.Estado
   </span>
         }
  </td>
   <td>
    <a asp-action="GestionarIngreso" asp-route-id="@ingreso.Id" 
           class="btn btn-sm btn-outline-success">
     <i class="bi bi-eye"></i>
      </a>
        </td>
    </tr>
   }
   </tbody>
   </table>
     </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Auto-refresh cada 30 segundos para mantener actualizado el monitoreo
        setTimeout(function() {
            location.reload();
        }, 30000);
    </script>
}
