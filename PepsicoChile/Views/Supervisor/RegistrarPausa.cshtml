@model Pausa
@{
    ViewData["Title"] = "Registrar Pausa";
    var ingresoId = ViewBag.IngresoId;
}

<div class="row">
 <div class="col-md-6 offset-md-3">
        <div class="card">
            <div class="card-header bg-warning">
 <h4 class="mb-0"><i class="bi bi-pause-circle"></i> Registrar Pausa en el Proceso</h4>
            </div>
<div class="card-body">
                <form asp-action="RegistrarPausa" method="post">
  <input type="hidden" asp-for="IngresoTallerId" value="@ingresoId" />
           <input type="hidden" asp-for="FechaInicio" value="@DateTime.Now" />
   <input type="hidden" asp-for="Activa" value="true" />
  
     <div class="mb-3">
          <label asp-for="Motivo" class="form-label">Motivo de la Pausa</label>
        <select asp-for="Motivo" class="form-select" required>
     <option value="">-- Seleccione el motivo --</option>
             <option value="Espera de repuestos">Espera de repuestos</option>
    <option value="Falta de personal">Falta de personal</option>
            <option value="Herramientas no disponibles">Herramientas no disponibles</option>
              <option value="Evaluación adicional requerida">Evaluación adicional requerida</option>
 <option value="Aprobación de presupuesto">Aprobación de presupuesto</option>
  <option value="Otro">Otro</option>
           </select>
             </div>

  <div class="mb-3">
 <label asp-for="Descripcion" class="form-label">Descripción Detallada</label>
<textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Describa los detalles de la pausa" required></textarea>
 </div>

          <div class="alert alert-info">
    <i class="bi bi-info-circle"></i> La pausa quedará activa hasta que se registre su finalización desde la gestión del ingreso.
      </div>

        <div class="d-grid gap-2">
             <button type="submit" class="btn btn-warning btn-lg">
        <i class="bi bi-save"></i> Registrar Pausa
             </button>
  <a asp-action="GestionarIngreso" asp-route-id="@ingresoId" class="btn btn-secondary">
      <i class="bi bi-arrow-left"></i> Cancelar
              </a>
          </div>
       </form>
   </div>
        </div>
    </div>
</div>
