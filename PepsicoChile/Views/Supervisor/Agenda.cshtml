@model AgendaViewModel
@{
    ViewData["Title"] = "Agenda de Ingresos";
 var ingresos = Model.IngresosActivos;
    var ingresosHoy = ingresos.Where(i => i.FechaProgramada.Date == DateTime.Today).ToList();
    var ingresosProximos = ingresos.Where(i => i.FechaProgramada.Date > DateTime.Today).ToList();
    var ingresosAtrasados = ingresos.Where(i => i.FechaProgramada.Date < DateTime.Today).ToList();
}

<div class="row mb-4">
    <div class="col-md-8">
        <h2><i class="bi bi-calendar3"></i> Agenda de Ingresos al Taller</h2>
        <p class="text-muted">Gestión de ingresos programados y en proceso</p>
    </div>
    <div class="col-md-4 text-end">
        <a asp-action="ProgramarIngreso" class="btn btn-success btn-lg">
            <i class="bi bi-calendar-plus"></i> Programar Ingreso
        </a>
    </div>
</div>

<!-- Resumen de Estados -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-danger text-white">
            <div class="card-body text-center">
                <h3>@ingresosAtrasados.Count</h3>
                <p class="mb-0">Atrasados</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <h3>@ingresosHoy.Count</h3>
                <p class="mb-0">Para Hoy</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <h3>@ingresosProximos.Count</h3>
                <p class="mb-0">Próximos</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
             <h3>@ingresos.Count</h3>
<p class="mb-0">Total Activos</p>
    </div>
    </div>
  </div>
</div>

<div class="row mb-3">
    <div class="col-12">
        <a asp-action="MonitoreoGeneral" class="btn btn-outline-primary">
            <i class="bi bi-display"></i> Ver Monitoreo General
        </a>
    </div>
</div>

@if (!Model.IngresosActivos.Any())
{
    <div class="alert alert-info text-center">
  <i class="bi bi-info-circle"></i> No hay ingresos programados o en proceso.
       <a asp-action="ProgramarIngreso" class="alert-link">Programar el primero</a>
 </div>
}

else
{
    @if (ingresosAtrasados.Any())
    {
        <div class="card mb-4 border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Ingresos Atrasados (@ingresosAtrasados.Count)</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Patente</th>
                                <th>Vehículo</th>
                                <th>Chofer</th>
                                <th>Mecánico</th>
                                <th>Fecha Programada</th>
                                <th>Motivo</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ingreso in ingresosAtrasados)
                            {
                                <tr class="table-danger">
                                    <td><strong>@ingreso.Vehiculo?.Patente</strong></td>
                                    <td>@ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo</td>
                                    <td>@ingreso.Chofer?.Nombre @ingreso.Chofer?.Apellido</td>
                                    <td>
                                        @if (ingreso.MecanicoAsignado != null)
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-person-gear"></i> @ingreso.MecanicoAsignado.Nombre @ingreso.MecanicoAsignado.Apellido
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="bi bi-person-x"></i> Sin asignar</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar-x text-danger"></i> @ingreso.FechaProgramada.ToString("dd/MM/yyyy HH:mm")
                                        <br />
                                        <small class="text-muted">Hace @((DateTime.Now - ingreso.FechaProgramada).Days) día(s)</small>
                                    </td>
                                    <td>@ingreso.MotivoIngreso</td>
                                    <td>
                                        <span class="badge bg-@(ingreso.Estado == "Programado" ? "info" : ingreso.Estado == "En Proceso" ? "warning" : "danger")">
                                            @ingreso.Estado
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="GestionarIngreso" asp-route-id="@ingreso.Id" class="btn btn-sm btn-primary">
                                            <i class="bi bi-gear"></i> Gestionar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (ingresosHoy.Any())
    {
        <div class="card mb-4 border-info">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-calendar-check"></i> Ingresos para Hoy (@ingresosHoy.Count)</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Patente</th>
                                <th>Vehículo</th>
                                <th>Chofer</th>
                                <th>Mecánico</th>
                                <th>Hora Programada</th>
                                <th>Motivo</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ingreso in ingresosHoy.OrderBy(i => i.FechaProgramada))
                            {
                                <tr class="table-info">
                                    <td><strong>@ingreso.Vehiculo?.Patente</strong></td>
                                    <td>@ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo</td>
                                    <td>@ingreso.Chofer?.Nombre @ingreso.Chofer?.Apellido</td>
                                    <td>
                                        @if (ingreso.MecanicoAsignado != null)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-person-check"></i> @ingreso.MecanicoAsignado.Nombre
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-warning"><i class="bi bi-person-dash"></i> Pendiente</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="bi bi-clock"></i> @ingreso.FechaProgramada.ToString("HH:mm")
                                    </td>
                                    <td>@ingreso.MotivoIngreso</td>
                                    <td>
                                        <span class="badge bg-@(ingreso.Estado == "Programado" ? "info" : ingreso.Estado == "En Proceso" ? "warning" : "danger")">
                                            @ingreso.Estado
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="GestionarIngreso" asp-route-id="@ingreso.Id" class="btn btn-sm btn-primary">
                                            <i class="bi bi-gear"></i> Gestionar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (ingresosProximos.Any())
    {
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-calendar-event"></i> Próximos Ingresos (@ingresosProximos.Count)</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Patente</th>
                                <th>Vehículo</th>
                                <th>Chofer</th>
                                <th>Mecánico</th>
                                <th>Fecha Programada</th>
                                <th>Motivo</th>
                                <th>Estado</th>
                                <th>Requiere</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ingreso in ingresosProximos.OrderBy(i => i.FechaProgramada))
                            {
                                <tr>
                                    <td><strong>@ingreso.Vehiculo?.Patente</strong></td>
                                    <td>@ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo</td>
                                    <td>@ingreso.Chofer?.Nombre @ingreso.Chofer?.Apellido</td>
                                    <td>
                                        @if (ingreso.MecanicoAsignado != null)
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-person-check"></i> @ingreso.MecanicoAsignado.Nombre
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-person-x"></i> No asignado</span>
                                        }
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar"></i> @ingreso.FechaProgramada.ToString("dd/MM/yyyy HH:mm")
                                        <br />
                                        <small class="text-muted">En @((ingreso.FechaProgramada - DateTime.Now).Days) día(s)</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@ingreso.MotivoIngreso</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-@(ingreso.Estado == "Programado" ? "info" : "warning")">
                                            @ingreso.Estado
                                        </span>
                                    </td>
                                    <td>
                                        @if (ingreso.RequiereRepuestos)
                                        {
                                            <span class="badge bg-warning"><i class="bi bi-tools"></i> Repuestos</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <a asp-action="GestionarIngreso" asp-route-id="@ingreso.Id" class="btn btn-sm btn-primary">
                                                <i class="bi bi-gear"></i>
                                            </a>
                                            @* <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown">
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item" asp-action="GestionarIngreso" asp-route-id="@ingreso.Id">
                                                        <i class="bi bi-gear"></i> Gestionar
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><h6 class="dropdown-header">Información</h6></li>
                                                <li>
                                                    <span class="dropdown-item-text small">
                                                        <strong>Supervisor:</strong> @(ingreso.Supervisor?.Nombre ?? "N/A")
                                                    </span>
                                                </li>
                                                @if (ingreso.MecanicoAsignado != null)
                                                {
                                                    <li>
                                                        <span class="dropdown-item-text small">
                                                            <strong>Mecánico:</strong> @ingreso.MecanicoAsignado.Nombre @ingreso.MecanicoAsignado.Apellido
                                                        </span>
                                                    </li>
                                                }
                                                @if (ingreso.FechaSalidaEstimada.HasValue)
                                                {
                                                    <li>
                                                        <span class="dropdown-item-text small">
                                                            <strong>Salida Est.:</strong> @ingreso.FechaSalidaEstimada.Value.ToString("dd/MM/yyyy")
                                                        </span>
                                                    </li>
                                                }
                                            </ul> *@
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}

<!-- Ingresos Completados Recientes -->
@if (Model.IngresosCompletados.Any())
{
    <div class="card border-success">
 <div class="card-header bg-success text-white">
     <h5 class="mb-0">
      <i class="bi bi-check-circle-fill"></i> 
   Trabajos Completados Recientemente (@Model.IngresosCompletados.Count)
 <small class="ms-2">(Últimos 30 días)</small>
     </h5>
 </div>
      <div class="card-body">
   <div class="table-responsive">
     <table class="table table-hover align-middle mb-0">
      <thead>
            <tr>
       <th>Patente</th>
      <th>Vehículo</th>
      <th>Chofer</th>
   <th>Mecánico</th>
   <th>Motivo</th>
    <th>Programado</th>
      <th>Finalizado</th>
       <th>Tiempo</th>
          <th>Estado</th>
       <th>Acciones</th>
    </tr>
    </thead>
         <tbody>
      @foreach (var ingreso in Model.IngresosCompletados)
        {
           var tiempoTotal = ingreso.FechaIngresoReal.HasValue && ingreso.FechaSalidaReal.HasValue
      ? (ingreso.FechaSalidaReal.Value - ingreso.FechaIngresoReal.Value).TotalHours
           : 0;
 
     <tr class="@(ingreso.Estado == "Completado" ? "table-success" : "")">
    <td><strong>@ingreso.Vehiculo?.Patente</strong></td>
  <td>
         @ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo
   </td>
    <td>@ingreso.Chofer?.Nombre</td>
      <td>
           @if (ingreso.MecanicoAsignado != null)
      {
    <span class="badge bg-success">
       @ingreso.MecanicoAsignado.Nombre
        </span>
       }
      else
        {
        <span class="text-muted small">N/A</span>
         }
    </td>
       <td><small>@ingreso.MotivoIngreso</small></td>
      <td><small>@ingreso.FechaProgramada.ToString("dd/MM HH:mm")</small></td>
        <td>
          <small>
    @if (ingreso.FechaSalidaReal.HasValue)
{
   @ingreso.FechaSalidaReal.Value.ToString("dd/MM HH:mm")
   }
       </small>
       </td>
  <td>
@if (tiempoTotal > 0)
        {
  <span class="badge bg-info">
       @tiempoTotal.ToString("N1") h
      </span>
    }
        else
      {
           <span class="text-muted">-</span>
          }
        </td>
  <td>
     @if (ingreso.Estado == "Completado")
      {
 <span class="badge bg-success">
  <i class="bi bi-check-circle"></i> Completado
 </span>
      }
      else
       {
<span class="badge bg-secondary">
       <i class="bi bi-x-circle"></i> @ingreso.Estado
</span>
      }
   </td>
     <td>
       <a asp-action="GestionarIngreso" asp-route-id="@ingreso.Id" 
   class="btn btn-sm btn-outline-success">
        <i class="bi bi-eye"></i> Ver
      </a>
        </td>
        </tr>
        }
  </tbody>
      </table>
     </div>
        </div>
    </div>
}
