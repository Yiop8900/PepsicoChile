@model List<IngresoTaller>
@{
    ViewData["Title"] = "Agenda de Ingresos";
}

<div class="row mb-4">
    <div class="col-12">
        <h1><i class="bi bi-calendar3"></i> Agenda de Ingresos Programados</h1>
        <p class="lead">Gestión de ingresos programados al taller</p>
 </div>
</div>

<div class="row mb-3">
    <div class="col-12">
  <a asp-action="ProgramarIngreso" class="btn btn-success">
 <i class="bi bi-calendar-plus"></i> Programar Nuevo Ingreso
</a>
        <a asp-action="MonitoreoGeneral" class="btn btn-primary">
  <i class="bi bi-display"></i> Ver Monitoreo General
  </a>
 </div>
</div>

<!-- Filtros -->
<div class="row mb-3">
    <div class="col-md-12">
    <div class="card">
       <div class="card-body">
      <div class="row">
       <div class="col-md-3">
   <label class="form-label">Filtrar por Estado</label>
        <select class="form-select">
          <option value="">Todos</option>
                <option value="Programado">Programado</option>
          <option value="En Proceso">En Proceso</option>
  <option value="Pausado">Pausado</option>
  <option value="Completado">Completado</option>
       </select>
     </div>
      <div class="col-md-3">
           <label class="form-label">Fecha Desde</label>
         <input type="date" class="form-control" />
                </div>
     <div class="col-md-3">
 <label class="form-label">Fecha Hasta</label>
   <input type="date" class="form-control" />
      </div>
      <div class="col-md-3 d-flex align-items-end">
      <button class="btn btn-primary w-100">
   <i class="bi bi-search"></i> Filtrar
</button>
     </div>
            </div>
        </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        @if (Model.Any())
        {
            <div class="table-responsive">
     <table class="table table-striped table-hover">
   <thead class="table-dark">
              <tr>
             <th>ID</th>
    <th>Patente</th>
      <th>Vehículo</th>
           <th>Chofer</th>
            <th>Fecha Programada</th>
         <th>Motivo</th>
    <th>Estado</th>
                   <th>Acciones</th>
        </tr>
             </thead>
         <tbody>
    @foreach (var ingreso in Model)
     {
      <tr>
            <td>@ingreso.Id</td>
 <td><strong>@ingreso.Vehiculo?.Patente</strong></td>
       <td>@ingreso.Vehiculo?.Marca @ingreso.Vehiculo?.Modelo</td>
         <td>@ingreso.Chofer?.Nombre @ingreso.Chofer?.Apellido</td>
           <td>@ingreso.FechaProgramada.ToString("dd/MM/yyyy HH:mm")</td>
       <td>@ingreso.MotivoIngreso</td>
         <td>
     @switch (ingreso.Estado)
       {
    case "Programado":
      <span class="badge bg-info">@ingreso.Estado</span>
   break;
    case "En Proceso":
          <span class="badge bg-warning">@ingreso.Estado</span>
           break;
     default:
    <span class="badge bg-secondary">@ingreso.Estado</span>
      break;
         }
 </td>
  <td>
       <a asp-action="GestionarIngreso" asp-route-id="@ingreso.Id" class="btn btn-sm btn-primary">
         <i class="bi bi-gear"></i> Gestionar
           </a>
 </td>
 </tr>
        }
   </tbody>
      </table>
            </div>
        }
        else
 {
     <div class="alert alert-info">
   <i class="bi bi-info-circle"></i> No hay ingresos programados.
  </div>
        }
    </div>
</div>
