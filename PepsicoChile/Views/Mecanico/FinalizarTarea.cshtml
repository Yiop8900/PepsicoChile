@model TareaTaller
@{
    ViewData["Title"] = "Finalizar Tarea";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-check-circle"></i> Finalizar Tarea</h2>
        <p class="text-muted">Complete la información para finalizar la tarea</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- Información de la Tarea -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Información de la Tarea</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Descripción:</dt>
                    <dd class="col-sm-8"><strong>@Model.Descripcion</strong></dd>

                    <dt class="col-sm-4">Vehículo:</dt>
                    <dd class="col-sm-8">
                        @Model.IngresoTaller?.Vehiculo?.Patente -
                        @Model.IngresoTaller?.Vehiculo?.Marca @Model.IngresoTaller?.Vehiculo?.Modelo
                    </dd>

                    <dt class="col-sm-4">Tiempo Estimado:</dt>
                    <dd class="col-sm-8">@Model.TiempoEstimadoHoras horas</dd>

                    @if (Model.FechaInicio.HasValue)
                    {
                        var transcurrido = (DateTime.Now - Model.FechaInicio.Value).TotalHours;
                        <dt class="col-sm-4">Tiempo Transcurrido:</dt>
                        <dd class="col-sm-8">
                            @transcurrido.ToString("N2") horas
                            @if (transcurrido > Model.TiempoEstimadoHoras)
                            {
                                <span class="badge bg-warning">Excedido</span>
                            }
                        </dd>
                    }
                </dl>
            </div>
        </div>

        <!-- Formulario de Finalización -->
        <div class="card">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-check-square"></i> Completar Tarea</h5>
            </div>
            <div class="card-body">
                <form asp-action="FinalizarTarea" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-4">
                        <label for="tiempoRealHoras" class="form-label">
                            <i class="bi bi-clock"></i> Tiempo Real Empleado (horas)
                        </label>
                        <input type="number" 
                               name="tiempoRealHoras" 
                               id="tiempoRealHoras"
                               class="form-control form-control-lg" 
                               min="0.01"
                               step="0.01"
                               value="@Model.TiempoEstimadoHoras"
                               required />
                        <small class="text-muted">
                            Ingrese el tiempo real que tomó completar la tarea. Ejemplos: 1, 1.5, 2.25, 0.5, etc.
                        </small>
                    </div>

                    <div class="mb-4">
                        <label for="observaciones" class="form-label">
                            <i class="bi bi-chat-left-text"></i> Observaciones Finales
                        </label>
                        <textarea name="observaciones"
                                  id="observaciones"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Describa el trabajo realizado, problemas encontrados, recomendaciones, etc."></textarea>
                        <small class="text-muted">Opcional: Agregue detalles importantes sobre el trabajo realizado</small>
                    </div>

                    <div class="mb-4">
                        <label for="imagenes" class="form-label">
                            <i class="bi bi-card-image"></i> Imágenes del Trabajo Completado
                        </label>
                        <input type="file" 
                               class="form-control" 
                               id="imagenes" 
                               name="imagenes" 
                               multiple 
                               accept="image/*"
                               onchange="previsualizarImagenes(this)" />
                        <small class="text-muted">Opcional: Suba fotos del trabajo finalizado (JPG, PNG, GIF). Puede seleccionar múltiples archivos.</small>
                        
                        <!-- Previsualización de imágenes -->
                        <div id="preview-container" class="mt-3 d-none">
                            <h6 class="mb-2">Vista previa:</h6>
                            <div id="preview-images" class="row g-2"></div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        Al finalizar esta tarea, se marcará como completada y se registrará el tiempo empleado y las imágenes adjuntas.
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="bi bi-check-circle-fill"></i> Finalizar Tarea
                        </button>
                        <a asp-action="DetalleTarea" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Resumen -->
        <div class="card">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0"><i class="bi bi-speedometer2"></i> Resumen</h5>
            </div>
            <div class="card-body">
                <div class="text-center mb-3">
                    <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
                </div>

                <h6 class="text-center mb-3">Trabajo Completado</h6>

                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <i class="bi bi-truck text-primary"></i>
                        @Model.IngresoTaller?.Vehiculo?.Patente
                    </li>
                    <li class="list-group-item">
                        <i class="bi bi-clock text-info"></i>
                        @Model.TiempoEstimadoHoras h estimadas
                    </li>
                    <li class="list-group-item">
                        <i class="bi bi-exclamation-triangle text-danger"></i>
                        Prioridad: @Model.Prioridad
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previsualizarImagenes(input) {
            const previewContainer = document.getElementById('preview-container');
            const previewImages = document.getElementById('preview-images');
            
            // Limpiar vista previa anterior
            previewImages.innerHTML = '';
            
            if (input.files && input.files.length > 0) {
                previewContainer.classList.remove('d-none');
                
                Array.from(input.files).forEach((file, index) => {
                    // Validar que sea una imagen
                    if (file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        
                        reader.onload = function(e) {
                            const col = document.createElement('div');
                            col.className = 'col-md-3 col-sm-4 col-6';
                            
                            const card = document.createElement('div');
                            card.className = 'card';
                            
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.className = 'card-img-top';
                            img.style.height = '150px';
                            img.style.objectFit = 'cover';
                            img.alt = file.name;
                            
                            const cardBody = document.createElement('div');
                            cardBody.className = 'card-body p-2';
                            
                            const fileName = document.createElement('small');
                            fileName.className = 'text-muted d-block text-truncate';
                            fileName.textContent = file.name;
                            
                            const fileSize = document.createElement('small');
                            fileSize.className = 'text-muted d-block';
                            fileSize.textContent = (file.size / 1024).toFixed(1) + ' KB';
                            
                            cardBody.appendChild(fileName);
                            cardBody.appendChild(fileSize);
                            card.appendChild(img);
                            card.appendChild(cardBody);
                            col.appendChild(card);
                            previewImages.appendChild(col);
                        };
                        
                        reader.readAsDataURL(file);
                    }
                });
            } else {
                previewContainer.classList.add('d-none');
            }
        }
        
        // Validación adicional en el submit
        document.querySelector('form').addEventListener('submit', function(e) {
            const tiempoInput = document.getElementById('tiempoRealHoras');
            const tiempo = parseFloat(tiempoInput.value);
            
            if (tiempo <= 0) {
                e.preventDefault();
                alert('El tiempo real debe ser mayor a 0');
                tiempoInput.focus();
                return false;
            }
            
            // Confirmar finalización
            const imagenes = document.getElementById('imagenes').files.length;
            const mensaje = imagenes > 0 
                ? `¿Confirma que desea finalizar la tarea con ${imagenes} imagen(es) adjunta(s)?`
                : '¿Confirma que desea finalizar la tarea?';
                
            if (!confirm(mensaje)) {
                e.preventDefault();
                return false;
            }
        });
    </script>
}
