@model TareaTaller
@{
    ViewData["Title"] = "Finalizar Tarea";
}

<div class="row">
  <div class="col-md-8 offset-md-2">
 <div class="card">
  <div class="card-header bg-success text-white">
   <h4 class="mb-0"><i class="bi bi-check-circle"></i> Finalizar Tarea</h4>
   </div>
       <div class="card-body">
    <div class="alert alert-info">
        <strong>Tarea:</strong> @Model.Descripcion<br />
  <strong>Vehículo:</strong> @Model.IngresoTaller?.Vehiculo?.Patente
 </div>

       <form asp-action="FinalizarTarea" method="post">
     <input type="hidden" asp-for="Id" />
     <input type="hidden" asp-for="IngresoTallerId" />
   
     <div class="mb-3">
   <label asp-for="TiempoRealHoras" class="form-label">Tiempo Real Trabajado (horas)</label>
      <input asp-for="TiempoRealHoras" type="number" class="form-control" min="0.5" step="0.5" required />
      <small class="form-text text-muted">Tiempo estimado: @Model.TiempoEstimadoHoras horas</small>
   </div>

   <div class="mb-3">
  <label asp-for="Observaciones" class="form-label">Observaciones Finales</label>
       <textarea asp-for="Observaciones" class="form-control" rows="4" placeholder="Describa el trabajo realizado, hallazgos, recomendaciones, etc." required></textarea>
        </div>

       <div class="mb-3">
   <label class="form-label">Estado del Trabajo</label>
        <div class="form-check">
       <input class="form-check-input" type="radio" name="estadoTrabajo" value="completado" checked>
   <label class="form-check-label">
  Trabajo completado satisfactoriamente
     </label>
   </div>
           <div class="form-check">
    <input class="form-check-input" type="radio" name="estadoTrabajo" value="requiereAtencion">
   <label class="form-check-label">
   Requiere atención adicional
      </label>
   </div>
        </div>

    <div class="d-grid gap-2">
         <button type="submit" class="btn btn-success btn-lg">
       <i class="bi bi-check-circle"></i> Confirmar Finalización
   </button>
      <a asp-action="DetalleTarea" asp-route-id="@Model.Id" class="btn btn-secondary">
    <i class="bi bi-arrow-left"></i> Cancelar
  </a>
    </div>
       </form>
        </div>
 </div>
    </div>
</div>
